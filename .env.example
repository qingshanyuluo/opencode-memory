OPENCODE_DB_PATH=~/.local/share/opencode/opencode.db
BOOTSTRAP_DB_PATH=~/.local/share/opencode-memory/bootstrap.db
MEMORY_DB_PATH=~/.local/share/opencode-memory/memory.db
